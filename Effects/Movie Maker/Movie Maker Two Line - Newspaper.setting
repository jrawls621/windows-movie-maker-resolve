						MaskHeight = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Height", },
						Center = Input { Expression = "Point(0.5, 0.48)", },
						Width = Input { Expression = "0.86", },
						Height = Input { Expression = "0.92", },
						SoftEdge = Input { Value = 0.0, },
					},
				},
				Clear = Background {
					Inputs = {
