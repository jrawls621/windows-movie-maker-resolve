						Foreground = Input { SourceOp = "Vid", Source = "Output", },
					},
				},
				Spin = Transform {
					Inputs = {
						Size = Input { Expression = "iif(((time/comp.RenderEnd)*116.0)<0, 0.05, iif(((time/comp.RenderEnd)*116.0)<30, 0.05+(0.8999999999999999)*(((time/comp.RenderEnd)*116.0)-(0))/(30), iif(((time/comp.RenderEnd)*116.0)<40, 0.95+(0.050000000000000044)*(((time/comp.RenderEnd)*116.0)-(30))/(10), 1)))", },
						Angle = Input { Expression = "iif(((time/comp.RenderEnd)*116.0)<0, 720, iif(((time/comp.RenderEnd)*116.0)<30, 720+(-680)*(((time/comp.RenderEnd)*116.0)-(0))/(30), iif(((time/comp.RenderEnd)*116.0)<40, 40+(-40)*(((time/comp.RenderEnd)*116.0)-(30))/(10), 0)))", },
						Input = Input { SourceOp = "P6", Source = "Output", },
					},
				},
				M1 = Merge {
					Inputs = {
						Background = Input { SourceOp = "Black", Source = "Output", },
						Foreground = Input { SourceOp = "Spin", Source = "Output", },
					},
				},
			},
		},
	},
	ActiveTool = "MovieMaker_TwoLineNewspaper"
