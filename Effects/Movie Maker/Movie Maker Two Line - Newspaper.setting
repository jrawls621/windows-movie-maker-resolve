						Width = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Width", },
						Height = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Height", },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
				},
				P1 = Merge {
					Inputs = {
						Background = Input { SourceOp = "Clear", Source = "Output", },
						Foreground = Input { SourceOp = "Paper", Source = "Output", },
						EffectMask = Input { SourceOp = "PMsk", Source = "Mask", },
					},
				},
				Col = Background {
					Inputs = {
