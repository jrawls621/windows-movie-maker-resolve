						Width = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Width", },
						Height = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Height", },
						TopLeftRed = Input { Value = 0.62, },
						TopLeftGreen = Input { Value = 0.62, },
						TopLeftBlue = Input { Value = 0.6, },
						TopLeftAlpha = Input { Value = 1, },
					},
				},
				C1 = RectangleMask {
					Inputs = {
						MaskWidth = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Width", },
						MaskHeight = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Height", },
						Center = Input { Expression = "Point(0.22, 0.32)", },
						Width = Input { Expression = "0.24", },
						Height = Input { Expression = "0.5", },
						SoftEdge = Input { Value = 0.0, },
					},
				},
				P2 = Merge {
					Inputs = {
						Background = Input { SourceOp = "P1", Source = "Output", },
						Foreground = Input { SourceOp = "Col", Source = "Output", },
						EffectMask = Input { SourceOp = "C1", Source = "Mask", },
					},
				},
				C2 = RectangleMask {
					Inputs = {
						MaskWidth = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Width", },
						MaskHeight = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Height", },
						Center = Input { Expression = "Point(0.8, 0.32)", },
						Width = Input { Expression = "0.18", },
						Height = Input { Expression = "0.5", },
						SoftEdge = Input { Value = 0.0, },
					},
				},
				P3 = Merge {
					Inputs = {
						Background = Input { SourceOp = "P2", Source = "Output", },
						Foreground = Input { SourceOp = "Col", Source = "Output", },
						EffectMask = Input { SourceOp = "C2", Source = "Mask", },
					},
				},
				Txt1 = TextPlus {
					Inputs = {
						Width = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Width", },
						Height = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Height", },
						StyledText = Input { Value = "Microsoft", },
						Size = Input { Expression = "0.13868999999999998*(4/3)/(comp:GetPrefs().Comp.FrameFormat.Width/comp:GetPrefs().Comp.FrameFormat.Height)", },
						Center = Input { Expression = "Point(0.5, 0.847)", },
