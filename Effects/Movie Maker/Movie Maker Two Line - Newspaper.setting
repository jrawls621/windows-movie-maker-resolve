						Foreground = Input { SourceOp = "Txt2", Source = "Output", },
					},
				},
				Vid = Transform {
					Inputs = {
						Size = Input { Expression = "iif(((time/comp.RenderEnd)*116.0)<0, 0.36, iif(((time/comp.RenderEnd)*116.0)<100, 0.36+(0.0)*(((time/comp.RenderEnd)*116.0)-(0))/(100), iif(((time/comp.RenderEnd)*116.0)<116, 0.36+(0.64)*(((time/comp.RenderEnd)*116.0)-(100))/(16), 1)))", },
						Center = Input { Expression = "Point(iif(((time/comp.RenderEnd)*116.0)<0, 0.52, iif(((time/comp.RenderEnd)*116.0)<100, 0.52+(0.0)*(((time/comp.RenderEnd)*116.0)-(0))/(100), iif(((time/comp.RenderEnd)*116.0)<116, 0.52+(-0.020000000000000018)*(((time/comp.RenderEnd)*116.0)-(100))/(16), 0.5))), iif(((time/comp.RenderEnd)*116.0)<0, 0.41, iif(((time/comp.RenderEnd)*116.0)<100, 0.41+(0.0)*(((time/comp.RenderEnd)*116.0)-(0))/(100), iif(((time/comp.RenderEnd)*116.0)<116, 0.41+(0.09000000000000002)*(((time/comp.RenderEnd)*116.0)-(100))/(16), 0.5))))", },
					},
				},
