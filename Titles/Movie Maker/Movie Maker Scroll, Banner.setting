{
	Tools = ordered() {
		MovieMaker_ScrollBanner = GroupOperator {
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Txt1", Source = "StyledText", Name = "Text", },
				Input2 = InstanceInput { SourceOp = "Txt1", Source = "Font", },
				Input3 = InstanceInput { SourceOp = "Txt1", Source = "Style", },
				Input4 = InstanceInput { SourceOp = "Txt1", Source = "Red1", Name = "Text Color", ControlGroup = 1, Default = 1, },
				Input5 = InstanceInput { SourceOp = "Txt1", Source = "Green1", ControlGroup = 1, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Txt1", Source = "Blue1", ControlGroup = 1, Default = 1, },
				Input7 = InstanceInput { SourceOp = "BG", Source = "TopLeftRed", Name = "Background Color", ControlGroup = 2, Default = 0.0627, },
				Input8 = InstanceInput { SourceOp = "BG", Source = "TopLeftGreen", ControlGroup = 2, Default = 0.251, },
				Input9 = InstanceInput { SourceOp = "BG", Source = "TopLeftBlue", ControlGroup = 2, Default = 0.502, },
				Input10 = InstanceInput { SourceOp = "BG", Source = "TopLeftAlpha", Name = "Background Opacity", Default = 1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Merge1", Source = "Output", }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				BG = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						Width = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Width", },
						Height = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Height", },
						TopLeftRed = Input { Value = 0.0627, },
						TopLeftGreen = Input { Value = 0.251, },
						TopLeftBlue = Input { Value = 0.502, },
						TopLeftAlpha = Input { Value = 1, },
					},
				},
				Txt1 = TextPlus {
					Inputs = {
						Width = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Width", },
						Height = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Height", },
						StyledText = Input { Value = "Windows Movie Maker", },
						Size = Input { Expression = "1.054044*(4/3)/(comp:GetPrefs().Comp.FrameFormat.Width/comp:GetPrefs().Comp.FrameFormat.Height)", },
						Center = Input { Expression = "Point((0.675-0.06875*((time/comp.RenderEnd)*116.0)), 0.5095)", },
						Font = Input { Value = "Microsoft Sans Serif", },
						Style = Input { Value = "Regular", },
						Red1 = Input { Value = 1.0, },
						Green1 = Input { Value = 1.0, },
						Blue1 = Input { Value = 1.0, },
						HorizontalLeftCenterRight = Input { Value = -1, },
					},
				},
				Merge1 = Merge {
					Inputs = {
						Background = Input { SourceOp = "BG", Source = "Output", },
						Foreground = Input { SourceOp = "Txt1", Source = "Output", },
						Blend = Input { Expression = "(iif(((time/comp.RenderEnd)*116.0)<0, 0, iif(((time/comp.RenderEnd)*116.0)<4, 0+(0.35)*(((time/comp.RenderEnd)*116.0)-0)/4, iif(((time/comp.RenderEnd)*116.0)<8, 0.35+(0.28)*(((time/comp.RenderEnd)*116.0)-4)/4, iif(((time/comp.RenderEnd)*116.0)<16, 0.63+(0.37)*(((time/comp.RenderEnd)*116.0)-8)/8, 1)))))*(iif(((time/comp.RenderEnd)*116.0)<100, 1, iif(((time/comp.RenderEnd)*116.0)<108, 1+(-0.24)*(((time/comp.RenderEnd)*116.0)-100)/8, iif(((time/comp.RenderEnd)*116.0)<114, 0.76+(-0.46)*(((time/comp.RenderEnd)*116.0)-108)/6, iif(((time/comp.RenderEnd)*116.0)<116, 0.3+(-0.3)*(((time/comp.RenderEnd)*116.0)-114)/2, 0)))))", },
					},
				},
			},
		},
	},
	ActiveTool = "MovieMaker_ScrollBanner"
}
