						Foreground = Input { SourceOp = "XF1", Source = "Output", },
						Blend = Input { Expression = "(iif(((time/comp.RenderEnd)*116.0)<1, 0, iif(((time/comp.RenderEnd)*116.0)<4, 0+(0.24)*(((time/comp.RenderEnd)*116.0)-1)/3, iif(((time/comp.RenderEnd)*116.0)<8, 0.24+(0.09000000000000002)*(((time/comp.RenderEnd)*116.0)-4)/4, iif(((time/comp.RenderEnd)*116.0)<12, 0.33+(0.14999999999999997)*(((time/comp.RenderEnd)*116.0)-8)/4, iif(((time/comp.RenderEnd)*116.0)<16, 0.48+(0.16000000000000003)*(((time/comp.RenderEnd)*116.0)-12)/4, iif(((time/comp.RenderEnd)*116.0)<20, 0.64+(0.12)*(((time/comp.RenderEnd)*116.0)-16)/4, iif(((time/comp.RenderEnd)*116.0)<24, 0.76+(0.09999999999999998)*(((time/comp.RenderEnd)*116.0)-20)/4, iif(((time/comp.RenderEnd)*116.0)<28, 0.86+(0.08999999999999997)*(((time/comp.RenderEnd)*116.0)-24)/4, iif(((time/comp.RenderEnd)*116.0)<30, 0.95+(0.050000000000000044)*(((time/comp.RenderEnd)*116.0)-28)/2, 1))))))))))*(iif(((time/comp.RenderEnd)*116.0)<88, 1, iif(((time/comp.RenderEnd)*116.0)<92, 1+(-0.08999999999999997)*(((time/comp.RenderEnd)*116.0)-88)/4, iif(((time/comp.RenderEnd)*116.0)<96, 0.91+(-0.13)*(((time/comp.RenderEnd)*116.0)-92)/4, iif(((time/comp.RenderEnd)*116.0)<100, 0.78+(-0.15000000000000002)*(((time/comp.RenderEnd)*116.0)-96)/4, iif(((time/comp.RenderEnd)*116.0)<104, 0.63+(-0.13)*(((time/comp.RenderEnd)*116.0)-100)/4, iif(((time/comp.RenderEnd)*116.0)<108, 0.5+(-0.15000000000000002)*(((time/comp.RenderEnd)*116.0)-104)/4, iif(((time/comp.RenderEnd)*116.0)<112, 0.35+(-0.14999999999999997)*(((time/comp.RenderEnd)*116.0)-108)/4, iif(((time/comp.RenderEnd)*116.0)<116, 0.2+(-0.2)*(((time/comp.RenderEnd)*116.0)-112)/4, 0)))))))))", },
