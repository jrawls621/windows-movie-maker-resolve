{
	Tools = ordered() {
		MovieMaker_CreditsScrollUpSidebySide = GroupOperator {
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Txt1", Source = "StyledText", Name = "Text", },
				Input2 = InstanceInput { SourceOp = "Txt1", Source = "Font", },
				Input3 = InstanceInput { SourceOp = "Txt1", Source = "Style", },
				Input4 = InstanceInput { SourceOp = "Txt1", Source = "Red1", Name = "Text Color", ControlGroup = 1, Default = 1, },
				Input5 = InstanceInput { SourceOp = "Txt1", Source = "Green1", ControlGroup = 1, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Txt1", Source = "Blue1", ControlGroup = 1, Default = 1, },
				Input7 = InstanceInput { SourceOp = "BG", Source = "TopLeftRed", Name = "Background Color", ControlGroup = 2, Default = 0.0627, },
				Input8 = InstanceInput { SourceOp = "BG", Source = "TopLeftGreen", ControlGroup = 2, Default = 0.251, },
				Input9 = InstanceInput { SourceOp = "BG", Source = "TopLeftBlue", ControlGroup = 2, Default = 0.502, },
				Input10 = InstanceInput { SourceOp = "BG", Source = "TopLeftAlpha", Name = "Background Opacity", Default = 1, },
				Input20 = InstanceInput { SourceOp = "Rcol", Source = "StyledText", Name = "Roles (one per line)", },
				Input21 = InstanceInput { SourceOp = "Ncol", Source = "StyledText", Name = "Names (one per line)", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "M_Ncol", Source = "Output", }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				BG = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						Width = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Width", },
						Height = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Height", },
						TopLeftRed = Input { Value = 0.0627, },
						TopLeftGreen = Input { Value = 0.251, },
						TopLeftBlue = Input { Value = 0.502, },
						TopLeftAlpha = Input { Value = 1, },
					},
				},
				Txt1 = TextPlus {
					Inputs = {
						Width = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Width", },
						Height = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Height", },
						StyledText = Input { Value = "Windows Movie Maker", },
						Size = Input { Expression = "0.09708299999999999*(4/3)/(comp:GetPrefs().Comp.FrameFormat.Width/comp:GetPrefs().Comp.FrameFormat.Height)", },
						Center = Input { Expression = "Point(0.5, 0.3755)", },
						Font = Input { Value = "Microsoft Sans Serif", },
						Style = Input { Value = "Regular", },
						Red1 = Input { Value = 1.0, },
						Green1 = Input { Value = 1.0, },
						Blue1 = Input { Value = 1.0, },
					},
				},
				Rcol = TextPlus {
					Inputs = {
						LineSpacing = Input { Value = 2.45, },
						Width = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Width", },
						Height = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Height", },
						StyledText = Input { Value = "Vocals\nVocals and Guitar\nGuitar\nBass\nDrums\nShopkeeper", },
						Size = Input { Expression = "0.060099*(4/3)/(comp:GetPrefs().Comp.FrameFormat.Width/comp:GetPrefs().Comp.FrameFormat.Height)", },
						Center = Input { Expression = "Point(0.33, -0.175)", },
						Font = Input { Expression = "Txt1.Font", },
						Style = Input { Expression = "Txt1.Style", },
						Red1 = Input { Expression = "Txt1.Red1", },
						Green1 = Input { Expression = "Txt1.Green1", },
						Blue1 = Input { Expression = "Txt1.Blue1", },
					},
				},
				Ncol = TextPlus {
					Inputs = {
						LineSpacing = Input { Value = 2.45, },
						Width = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Width", },
						Height = Input { Expression = "comp:GetPrefs().Comp.FrameFormat.Height", },
						StyledText = Input { Value = "Scott Anderson\nJames Black\nRick Jackett\nSean Anderson\nRich Beddoe\nMorshu", },
						Size = Input { Expression = "0.060099*(4/3)/(comp:GetPrefs().Comp.FrameFormat.Width/comp:GetPrefs().Comp.FrameFormat.Height)", },
						Center = Input { Expression = "Point(0.66, -0.175)", },
						Font = Input { Expression = "Txt1.Font", },
						Style = Input { Expression = "Txt1.Style", },
						Red1 = Input { Expression = "Txt1.Red1", },
						Green1 = Input { Expression = "Txt1.Green1", },
						Blue1 = Input { Expression = "Txt1.Blue1", },
					},
				},
				X_Txt1 = Transform {
					Inputs = {
						UseSizeAndAspect = Input { Value = 0, },
						Pivot = Input { Expression = "Point(0.5, 0.5)", },
						XSize = Input { Expression = "1.032*(1)", },
						YSize = Input { Expression = "1", },
						Angle = Input { Expression = "0", },
						Center = Input { Expression = "Point(0.5, 0.5-((-0.0215*((time/comp.RenderEnd)*116-30))))", },
						Input = Input { SourceOp = "Txt1", Source = "Output", },
					},
				},
				M_Txt1 = Merge {
					Inputs = {
						Background = Input { SourceOp = "BG", Source = "Output", },
						Foreground = Input { SourceOp = "X_Txt1", Source = "Output", },
					},
				},
				X_Rcol = Transform {
					Inputs = {
						UseSizeAndAspect = Input { Value = 0, },
						Pivot = Input { Expression = "Point(0.5, 0.5)", },
						XSize = Input { Expression = "1.032*(1)", },
						YSize = Input { Expression = "1", },
						Angle = Input { Expression = "0", },
						Center = Input { Expression = "Point(0.5, 0.5-((-0.0215*((time/comp.RenderEnd)*116-30))))", },
						Input = Input { SourceOp = "Rcol", Source = "Output", },
					},
				},
				M_Rcol = Merge {
					Inputs = {
						Background = Input { SourceOp = "M_Txt1", Source = "Output", },
						Foreground = Input { SourceOp = "X_Rcol", Source = "Output", },
					},
				},
				X_Ncol = Transform {
					Inputs = {
						UseSizeAndAspect = Input { Value = 0, },
						Pivot = Input { Expression = "Point(0.5, 0.5)", },
						XSize = Input { Expression = "1.032*(1)", },
						YSize = Input { Expression = "1", },
						Angle = Input { Expression = "0", },
						Center = Input { Expression = "Point(0.5, 0.5-((-0.0215*((time/comp.RenderEnd)*116-30))))", },
						Input = Input { SourceOp = "Ncol", Source = "Output", },
					},
				},
				M_Ncol = Merge {
					Inputs = {
						Background = Input { SourceOp = "M_Rcol", Source = "Output", },
						Foreground = Input { SourceOp = "X_Ncol", Source = "Output", },
					},
				},
			},
		},
	},
	ActiveTool = "MovieMaker_CreditsScrollUpSidebySide"
}
